load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("@rules_cc//cc:defs.bzl", "cc_library")

# C library that will be called from Go via cgo
cc_library(
    name = "greet",
    srcs = ["greet.c"],
    hdrs = ["greet.h"],
    visibility = ["//visibility:public"],
)

# Go binary that uses cgo to call the C library
go_binary(
    name = "cgo_example",
    embed = [":cgo_example_lib"],
    visibility = ["//visibility:public"],
)

go_library(
    name = "cgo_example_lib",
    srcs = ["main.go"],
    cdeps = [":greet"],
    cgo = True,
    importpath = "github.com/sluongng/toolchains_llvm_bootstrapped/examples/rules_go",
    visibility = ["//visibility:private"],
)
